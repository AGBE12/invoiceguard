# Modèle de configuration InvoiceGuard — copiez ce fichier en `.env`
# puis renseignez vos vraies valeurs. Le fichier `.env` n'est pas committé.

# Identité du projet
PROJECT_NAME="InvoiceGuard"

# Base de données
DATABASE_URL="sqlite:///./invoiceguard.db"

# Sécurité : GÉNÉREZ une vraie clé via :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-me-with-a-real-random-key"

# Durée de validité du token JWT (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
